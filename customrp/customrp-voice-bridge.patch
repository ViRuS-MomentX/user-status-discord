+        /// <summary>
+        /// Replaces the presence text with the voice channel the user is sitting in.
+        /// </summary>
+        /// <remarks>
+        /// Deliberately the last thing to touch the presence, and a no-op whenever the user isn't
+        /// in voice: the rest of the time the presence set up in the main window stays in charge.
+        /// </remarks>
+        private void ApplyVoiceStatus(RichPresence rp)
+        {
+            if (!settings.voiceEnabled)
+                return;
+
+            var status = voiceBridge.Status;
+
+            // No answer from the bot, or the user left the channel — nothing to show
+            if (status == null || !status.InVoice)
+                return;
+
+            rp.Details = status.Format(settings.voiceDetails);
+            rp.State = status.Format(settings.voiceState);
+
+            if (settings.voiceTimestamp)
+                rp.Timestamps = new Timestamps(status.Since);
+        }
+
+        /// <summary>
+        /// Starts or stops polling the bot, depending on whether the feature is turned on.
+        /// </summary>
+        private void ApplyVoiceSettings()
+        {
+            if (settings.voiceEnabled)
+                voiceBridge.Start(settings.voiceUrl, settings.voiceToken);
+            else
+                voiceBridge.Stop();
+        }
+
+        /// <summary>
+        /// Called when the user joins or leaves a voice channel.
+        /// </summary>
+        /// <remarks>
+        /// Raised on the bridge's own thread, hence the invoke. Only fires when something actually
+        /// changed, so this can't spam Discord's presence rate limit.
+        /// </remarks>
+        private void VoiceStatusChanged(object sender, EventArgs e)
+        {
+            // The first poll is fired off from the constructor and can come back before the window
+            // exists, and Invoke throws on a form without a handle.
+            if (!settings.voiceEnabled || !IsHandleCreated || client == null || client.IsDisposed)
+                return;
+
+            Invoke(new MethodInvoker(() => SetPresence()));
+        }
+
+        /// <summary>
+        /// Called when you click Settings -> Voice channel status.
+        /// </summary>
+        private void OpenVoiceBridgeSettings(object sender, EventArgs e)
+        {
+            // The window polls the bot while it's open so a wrong address shows up right there
+            using (var form = new VoiceBridgeForm(voiceBridge))
+                form.ShowDialog(this);
+
+            Utils.SaveSettings();
+            ApplyVoiceSettings();
+
+            if (client != null && !client.IsDisposed)
+                SetPresence();
+        }
+
         /// <summary>
         /// Sets up the startup link for the app.
         /// </summary>
@@ -1421,6 +1501,8 @@ namespace CustomRPC
             if (client != null)
