diff --git a/CustomRPC/VoiceBridge.cs b/CustomRPC/VoiceBridge.cs
new file mode 100644
index 0000000..bbf86bc
--- /dev/null
+++ b/CustomRPC/VoiceBridge.cs
@@ -0,0 +1,330 @@
+using System;
+using System.Collections.Generic;
+using System.Net.Http;
+using System.Text;
+using System.Threading.Tasks;
+using System.Web.Script.Serialization;
+using Timer = System.Timers.Timer;
+
+namespace CustomRPC
+{
+    /// <summary>
+    /// Voice state of the tracked user, as reported by the companion bot.
+    /// </summary>
+    public class VoiceStatus
+    {
+        /// <summary>
+        /// Whether the bot itself is connected to the Discord gateway. If it isn't, the rest of
+        /// the fields are the last thing it saw rather than the current state.
+        /// </summary>
+        public bool BotConnected { get; set; }
+
+        /// <summary>
+        /// Whether the user is sitting in a voice channel right now.
+        /// </summary>
+        public bool InVoice { get; set; }
+
+        /// <summary>
+        /// Name of the server the voice channel belongs to.
+        /// </summary>
+        public string Guild { get; set; } = "";
+
+        /// <summary>
+        /// Name of the voice channel.
+        /// </summary>
+        public string Channel { get; set; } = "";
+
+        /// <summary>
+        /// How many people (bots excluded) are in that channel.
+        /// </summary>
+        public int Members { get; set; }
+
+        /// <summary>
+        /// When the user joined the current channel, in UTC. This is what the presence timer counts from.
+        /// </summary>
+        public DateTime Since { get; set; } = DateTime.UtcNow;
+
+        /// <summary>
+        /// Fills a template like "{server}" or "{channel}" in with this status.
+        /// </summary>
+        /// <returns>The finished line, cut down to what Discord will accept.</returns>
+        public string Format(string template)
+        {
+            return TrimToLimit((template ?? "")
+                .Replace("{server}", Guild)
+                .Replace("{channel}", Channel)
+                .Replace("{members}", Members.ToString()));
+        }
+
+        /// <summary>
+        /// Cuts a string down to the 128 bytes Discord allows in a presence line.
+        /// </summary>
+        /// <remarks>
+        /// Counted in bytes, not characters, on purpose: Discord measures the UTF-8 length, and a
+        /// Cyrillic channel name eats two bytes per letter while an emoji eats four. A name that
+        /// looks well within the limit can still be rejected, and a rejected line takes the whole
+        /// presence update down with it.
+        /// </remarks>
+        static string TrimToLimit(string text)
+        {
+            const int limit = 128;
+
+            if (Encoding.UTF8.GetByteCount(text) <= limit)
+                return text;
+
+            var used = 0;
+
+            for (var i = 0; i < text.Length; i++)
+            {
+                // A surrogate pair is one character in two chars and must not be split in half
+                var chunk = char.IsHighSurrogate(text[i]) && i + 1 < text.Length ? 2 : 1;
+                var size = Encoding.UTF8.GetByteCount(text.Substring(i, chunk));
+
+                if (used + size > limit)
+                    return text.Substring(0, i);
+
+                used += size;
+                i += chunk - 1;
+            }
+
+            return text;
+        }
+
+        /// <summary>
+        /// Compares everything that can affect the presence.
+        /// </summary>
+        /// <remarks>
+        /// <see cref="BotConnected"/> is deliberately left out: it flips while the bot reconnects
+        /// and on its own says nothing about what the presence should look like.
+        /// </remarks>
+        public bool SameAs(VoiceStatus other)
+        {
+            if (other == null)
+                return false;
+
+            if (!InVoice || !other.InVoice)
+                return InVoice == other.InVoice;
+
+            return Guild == other.Guild && Channel == other.Channel && Members == other.Members && Since == other.Since;
+        }
+    }
+
+    /// <summary>
+    /// Polls the companion bot for the user's voice state.
+    /// </summary>
+    /// <remarks>
+    /// Discord doesn't let an app read someone's voice channel over the Rich Presence pipe, so a
+    /// bot sitting on the server watches the voice channels instead and serves what it sees on
+    /// localhost. This class is the client half of that: it asks, and raises
+    /// <see cref="StatusChanged"/> whenever the answer is different from the last one.
+    /// </remarks>
+    public class VoiceBridge : IDisposable
+    {
+        /// <summary>
+        /// How often the bot gets asked, in milliseconds.
+        /// </summary>
+        /// <remarks>
+        /// Discord rate limits presence updates to about one per five seconds, and we only push an
+        /// update when something actually changed, so polling this often can't outrun the limit.
+        /// </remarks>
+        const int PollInterval = 5 * 1000;
+
+        /// <summary>
+        /// The bot answers from memory, so anything slower than this means it's gone.
+        /// </summary>
+        const int RequestTimeout = 3 * 1000;
+
+        static readonly DateTime UnixEpoch = new DateTime(1970, 1, 1, 0, 0, 0, DateTimeKind.Utc);
+
+        readonly HttpClient http = new HttpClient { Timeout = TimeSpan.FromMilliseconds(RequestTimeout) };
+        readonly JavaScriptSerializer json = new JavaScriptSerializer();
+        readonly Timer timer = new Timer(PollInterval);
+
+        string url = "";
+        string authToken = "";
+        bool polling = false;
+        bool disposed = false;
+
+        /// <summary>
+        /// Raised when the voice state changes in a way the presence should follow.
+        /// </summary>
+        /// <remarks>
+        /// Raised on a timer thread, so handlers touching the UI have to marshal to it themselves.
+        /// </remarks>
+        public event EventHandler StatusChanged;
+
+        /// <summary>
+        /// Last known voice state, or <see langword="null"/> if the bot hasn't answered yet.
+        /// </summary>
+        public VoiceStatus Status { get; private set; }
+
+        /// <summary>
+        /// Whether the last poll got through. <see langword="False"/> usually just means the bot isn't running.
+        /// </summary>
+        public bool Reachable { get; private set; }
+
+        /// <summary>
+        /// Why the last poll failed, for showing in the settings window. Empty when all is well.
+        /// </summary>
+        public string LastError { get; private set; } = "";
+
+        public VoiceBridge()
+        {
+            timer.AutoReset = false; // Restarted by hand after each poll so slow answers can't pile up
+            timer.Elapsed += async (s, e) => await Poll();
+        }
+
+        /// <summary>
+        /// Starts polling the given endpoint, replacing whatever it was polling before.
+        /// </summary>
+        /// <param name="endpoint">Full URL of the bot's endpoint, e.g. http://127.0.0.1:7373/voice.</param>
+        /// <param name="token">Shared secret, or an empty string if the bot doesn't ask for one.</param>
+        public void Start(string endpoint, string token)
+        {
+            if (disposed)
+                return;
+
+            url = (endpoint ?? "").Trim();
+            authToken = (token ?? "").Trim();
+
+            Stop();
+
+            if (url.Length == 0)
+                return;
+
+            // Ask immediately instead of making the user stare at an empty panel for five seconds
+            Task.Run(async () => await Poll());
+        }
+
+        /// <summary>
+        /// Stops polling and forgets the last known state.
+        /// </summary>
+        public void Stop()
+        {
+            timer.Stop();
+            Status = null;
+            Reachable = false;
+            LastError = "";
+        }
+
+        /// <summary>
+        /// Asks the bot once and raises <see cref="StatusChanged"/> if the answer is new.
+        /// </summary>
+        async Task Poll()
+        {
+            // A previous poll can still be waiting on a timeout; skipping is better than queueing up
+            if (disposed || polling || url.Length == 0)
+                return;
+
+            polling = true;
+
+            try
+            {
+                var request = new HttpRequestMessage(HttpMethod.Get, url);
+
+                if (authToken.Length > 0)
+                    request.Headers.Add("X-Auth-Token", authToken);
+
+                var response = await http.SendAsync(request);
+
+                if (!response.IsSuccessStatusCode)
+                {
+                    Fail($"HTTP {(int)response.StatusCode}");
+                    return;
+                }
+
+                Apply(await response.Content.ReadAsStringAsync());
+            }
+            catch (Exception e)
+            {
+                // The bot being closed is the normal case here, not an error worth a message box
+                Fail(e.InnerException?.Message ?? e.Message);
+            }
+            finally
+            {
+                polling = false;
+
+                if (!disposed && url.Length > 0)
+                    timer.Start();
+            }
+        }
+
+        /// <summary>
+        /// Parses one answer from the bot and publishes it.
+        /// </summary>
+        void Apply(string body)
+        {
+            VoiceStatus parsed;
+
+            try
+            {
+                parsed = Parse(body);
+            }
+            catch
+            {
+                // Something is answering on that port, but it isn't our bot
+                Fail(Strings.voiceErrorBadResponse);
+                return;
+            }
+
+            Reachable = true;
+            LastError = "";
+
+            var previous = Status;
+            Status = parsed;
+
+            if (!parsed.SameAs(previous))
+                StatusChanged?.Invoke(this, EventArgs.Empty);
+        }
+
+        /// <summary>
+        /// Turns the bot's JSON into a <see cref="VoiceStatus"/>.
+        /// </summary>
+        VoiceStatus Parse(string body)
+        {
+            var raw = (Dictionary<string, object>)json.DeserializeObject(body);
+
+            var status = new VoiceStatus
+            {
+                BotConnected = Convert.ToBoolean(raw["connected"]),
+                InVoice = Convert.ToBoolean(raw["inVoice"]),
+            };
+
+            // Everything below only comes with the answer when the user is actually in a channel
+            if (!status.InVoice)
+                return status;
+
+            status.Guild = Convert.ToString(raw["guild"]) ?? "";
+            status.Channel = Convert.ToString(raw["channel"]) ?? "";
+            status.Members = Convert.ToInt32(raw["members"]);
+            status.Since = UnixEpoch.AddMilliseconds(Convert.ToDouble(raw["since"]));
+
+            return status;
+        }
+
+        /// <summary>
+        /// Records a failed poll, and tells the form about it if it means the presence has to change back.
+        /// </summary>
+        void Fail(string reason)
+        {
+            LastError = reason;
+            Reachable = false;
+
+            // Losing the bot means we can't claim the user is in voice anymore, so the presence
+            // has to fall back to whatever is configured in the main window.
+            var wasInVoice = Status != null && Status.InVoice;
+            Status = null;
+
+            if (wasInVoice)
+                StatusChanged?.Invoke(this, EventArgs.Empty);
+        }
+
+        public void Dispose()
+        {
+            disposed = true;
+            timer.Stop();
+            timer.Dispose();
+            http.Dispose();
+        }
+    }
+}
