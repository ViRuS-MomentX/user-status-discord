# Токен бота со страницы приложения: Bot -> Reset Token.
# Никому его не показывай и не заливай в публичный репозиторий.
bot.token=

# ID сервера, за которым следим. Один сервер, остальные игнорируются.
# Включи в Discord режим разработчика (Настройки -> Расширенные),
# затем правый клик по серверу -> Копировать ID сервера.
guild.id=

# ID твоего аккаунта: правый клик по себе -> Копировать ID пользователя.
user.id=

# Адрес локального эндпоинта, откуда CustomRP забирает состояние.
# 127.0.0.1 означает, что снаружи к нему не достучаться, — так и надо.
http.host=127.0.0.1
http.port=7373

# Необязательный общий секрет. Если заполнить, то же значение
# надо вписать в CustomRP. Для localhost можно оставить пустым.
http.token=

# ---------------------------------------------------------------------------
# Ранговая система
# ---------------------------------------------------------------------------
# Включает команды «эмбед ранк» и «баланс», начисление монет и кнопку повышения.
# Требует включённого интента MESSAGE CONTENT в настройках приложения
# и права «Управление ролями» у бота.
rank.enabled=false

# Эмодзи монеты. Чтобы узнать код своего, напиши в Discord \:vcoin:
# с обратной чертой — в отправленном сообщении будет готовая строка.
rank.coin=<:vcoin:000000000000000000>

# Сколько минут в голосовом канале даёт одну монету.
# Время идёт, только если в канале есть кто-то ещё, кроме тебя.
rank.minutes=30

# Роль до первого повышения. ID или точное название роли.
# Правый клик по роли в настройках сервера -> Копировать ID.
rank.start=000000000000000000

# Ступени в порядке повышения, от дешёвой к дорогой: роль:цена.
# Нумерация должна идти подряд — первый пропущенный номер заканчивает лестницу.
rank.1=000000000000000000:3
rank.2=000000000000000000:5
rank.3=000000000000000000:10
rank.4=000000000000000000:15
rank.5=000000000000000000:20
rank.6=000000000000000000:25
rank.7=000000000000000000:30
