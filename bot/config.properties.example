# Токен бота со страницы приложения: Bot -> Reset Token.
# Никому его не показывай и не заливай в публичный репозиторий.
bot.token=

# ID сервера, за которым следим. Один сервер, остальные игнорируются.
# Включи в Discord режим разработчика (Настройки -> Расширенные),
# затем правый клик по серверу -> Копировать ID сервера.
guild.id=

# ID твоего аккаунта: правый клик по себе -> Копировать ID пользователя.
user.id=

# Каким бот показывается в списке участников:
# online, idle, dnd (не беспокоить) или invisible.
bot.status=dnd

# Адрес локального эндпоинта, откуда CustomRP забирает состояние.
# 127.0.0.1 означает, что снаружи к нему не достучаться, — так и надо.
http.host=127.0.0.1
http.port=7373

# Необязательный общий секрет. Если заполнить, то же значение
# надо вписать в CustomRP. Для localhost можно оставить пустым.
http.token=

# ---------------------------------------------------------------------------
# Ранговая система
# ---------------------------------------------------------------------------
# Включает команды «эмбед ранк» и «баланс», начисление монет и кнопку повышения.
# Требует включённого интента MESSAGE CONTENT в настройках приложения
# и права «Управление ролями» у бота.
rank.enabled=false

# Эмодзи монеты. Чтобы узнать код своего, напиши в Discord \:vcoin:
# с обратной чертой — в отправленном сообщении будет готовая строка.
rank.coin=<:vcoin:000000000000000000>

# Сколько минут в голосовом канале даёт одну монету.
# Время идёт, только если в канале есть кто-то ещё, кроме тебя.
rank.minutes=30

# Роль до первого повышения. ID или точное название роли.
# Правый клик по роли в настройках сервера -> Копировать ID.
rank.start=000000000000000000

# Ступени в порядке повышения, от дешёвой к дорогой: роль:цена.
# Нумерация должна идти подряд — первый пропущенный номер заканчивает лестницу.
rank.1=000000000000000000:3
rank.2=000000000000000000:5
rank.3=000000000000000000:10
rank.4=000000000000000000:15
rank.5=000000000000000000:20
rank.6=000000000000000000:25
rank.7=000000000000000000:30

# ---------------------------------------------------------------------------
# Роль для ботов
# ---------------------------------------------------------------------------
# Выдаётся всем ботам сервера: при запуске — тем, кто уже есть, дальше — новым
# в момент входа. Пусто — выдача выключена.
# Требует интента SERVER MEMBERS и права «Управление ролями».
bots.role=

# ---------------------------------------------------------------------------
# Очистка канала
# ---------------------------------------------------------------------------
# Включает команду «очистить 20». Доступна тем, у кого есть право
# «Управление сообщениями». Требует интента MESSAGE CONTENT.
moderation.enabled=false

# ---------------------------------------------------------------------------
# Музыка
# ---------------------------------------------------------------------------
# Команды start / скип / стоп / очередь. Звук берётся с SoundCloud,
# плейлист подбирается через Last.fm. Требует интента MESSAGE CONTENT
# и права подключаться к голосовым каналам и говорить в них.
music.enabled=false

# Откуда брать подсказки, что играть после введённого: itunes или lastfm.
# iTunes работает без ключей и отвечает оттуда, откуда Last.fm отказывает,
# но похожих песен у него нет — продолжением идут другие песни того же
# исполнителя. Last.fm умеет настоящие похожие, но доступен не везде.
music.catalog=itunes

# Магазин iTunes, в котором искать. US находит почти всё, включая русское.
music.itunes.country=US

# Чем представляться iTunes. Пусто — обычный браузерный заголовок: Apple
# отвечает 403 с пустым телом клиентам, которых не узнаёт.
music.itunes.useragent=

# Ключ Last.fm: https://www.last.fm/api/account/create
# Нужен только при music.catalog=lastfm.
music.lastfm.key=

# Сколько треков ставить в очередь за одну команду start (1-50).
music.playlist=15

# Лист иконок для кнопок панели: одна картинка 4×4, шестнадцать клеток.
# Бот сам режет её и заводит эмодзи vb_quieter, vb_previous и так далее.
# Иконки принадлежат приложению, а не серверу: слотов сервера они не занимают
# и прав на сервере не требуют. Порядок клеток слева направо, сверху вниз:
# тише, предыдущая, пауза, продолжить, следующая, громче, зима, весна, чарты,
# осень, лето, своя песня, исполнитель, стоп, код, очистить. Файл ищется рядом
# с этим config.properties. Пока листа нет, на кнопках стандартные символы —
# панель работает и так.
music.panel.sheet=emoji-sheet.png

# Картинка-подсказка внутри карточки плеера: что означает каждая иконка.
# Положи файл рядом с этим config.properties — бот приложит его к панели сам,
# хостинг и ссылки не нужны.
music.panel.legend=panel-legend.png

# Тот же рисунок ссылкой — запасной вариант, если файл держать рядом неудобно.
# Работает, только когда файла из music.panel.legend нет. Нужна прямая ссылка
# на изображение: например, загрузить его в любой канал Discord и скопировать
# ссылку на файл. Пусто — панель будет без картинки.
music.panel.image=

# Что искать по сезонным кнопкам панели (🎄 🌸 🍂 ☀️). Это обычный поисковый
# запрос к каталогу, так что на русском и на английском найдётся разное.
# Пусто — значения по умолчанию, указанные ниже.
music.season.winter=christmas songs
music.season.spring=spring hits
music.season.autumn=autumn chill
music.season.summer=summer hits

# ---------------------------------------------------------------------------
# Лента постов сайта
# ---------------------------------------------------------------------------
# Бот заглядывает в ленту и объявляет в канале записи, которых там ещё не было.
posts.enabled=false

# Адрес файла с лентой. Его выкладывает сборка сайта рядом со страницами.
posts.url=https://virus-momentx.vercel.app/posts.json

# Канал, куда объявлять новые записи.
posts.channel=

# Как часто заглядывать в ленту, минут (1-1440).
posts.minutes=10

# ---------------------------------------------------------------------------
# Своя фонотека
# ---------------------------------------------------------------------------
# Скачанные треки лежат на диске и играют всегда: ни таймаутов, ни блокировок.
# Команда start ищет сначала здесь и только потом идёт на площадку.
music.library.enabled=false

# Папка со скачанным, рядом с этим config.properties. Опись — library.json
# внутри неё; удалять файлы можно руками, бот заметит пропажу при запуске.
music.library.folder=library

# Канал, куда кидают ссылки на песни. Бросил ссылку — бот скачал и добавил.
# Пусто — приём ссылок выключен, но фонотека всё равно играет.
music.library.channel=

# Чем качать. Возьми yt-dlp с https://github.com/yt-dlp/yt-dlp/releases
# (yt-dlp.exe для Windows) и положи рядом с этим config.properties.
# Файл ищется сначала здесь, и только если его тут нет — по системным путям.
# То же самое с music.library.ffmpeg и music.library.cookiefile.
# Обновлять качалку надо самому: площадки меняют защиту чаще, чем выходит бот.
music.library.ytdlp=yt-dlp

# Где лежит ffmpeg — им yt-dlp вытаскивает звук. Пусто — искать в PATH.
music.library.ffmpeg=

# Файл с куками в формате Netscape. Надёжнее, чем читать их прямо из браузера:
# тот держит свою базу открытой, а свежий Chrome на Windows ещё и шифрует её.
# Выгружается расширением вроде «Get cookies.txt LOCALLY». Если задан, берётся
# он, а music.library.cookies не смотрится.
music.library.cookiefile=

# Откуда брать куки браузера: chrome, firefox, edge, opera, brave.
# Часть роликов YouTube отдаёт только вошедшим — снаружи «Video unavailable»,
# а у залогиненного обычная страница. Браузер при этом должен быть закрыт.
# Пусто — без кук.
music.library.cookies=

# Каким приложением представляться YouTube: tv, android, ios, mweb, web_safari.
# Можно перечислить через запятую — тогда качалка пробует их по порядку.
# YouTube отвечает по-разному разным клиентам: то, что закрыто для браузера,
# нередко открыто для телевизора. Пробовать приходится руками. Помогает при
# ошибках вида «The page needs to be reloaded». Пусто — как решит yt-dlp.
music.library.client=

# Что ещё передать yt-dlp, через пробел. Способ починиться на месте, когда
# площадка сломалась, не дожидаясь новой сборки бота.
#
# Оставь пустым, если не знаешь, что сюда писать. Прокси прописывают здесь
# только когда он действительно поднят: иначе качалка будет ломиться в него
# и падать с «Failed to establish a new connection», хотя интернет в порядке.
music.library.args=

# Рамки на скачиваемое: минуты, мегабайты и сколько ждать одну закачку.
# Качается только звуковая дорожка, так что мегабайты считаются по ней:
# трёхминутная песня весит около трёх-пяти МБ.
music.library.minutes=15
music.library.megabytes=30
music.library.waitminutes=5

# Площадки, ссылки на которые принимаются. Всё остальное отклоняется сразу:
# иначе в канал можно бросить ссылку куда угодно, и бот честно потащит файл
# любого размера с незнакомого сервера.
music.library.hosts=youtube.com,youtu.be,soundcloud.com,bandcamp.com,music.yandex.ru,vk.com,vkvideo.ru,archive.org,jamendo.com,freemusicarchive.org,ccmixter.org

# ---------------------------------------------------------------------------
# Мост с Telegram
# ---------------------------------------------------------------------------
# Сообщения ходят между каналом Discord и группой Telegram в обе стороны.
bridge.enabled=false

# Канал Discord, который связываем с группой.
bridge.channel=

# Токен телеграм-бота от @BotFather. Держи его как пароль: у кого токен,
# тот пишет в группу от имени бота. Можно задать переменной окружения
# VOICEBRIDGE_TELEGRAM_TOKEN, тогда в файле его не будет вовсе.
bridge.telegram.token=

# Куда писать: @имя публичной группы или её числовой ID для закрытой.
bridge.telegram.chat=@defenseBrawl

# Переносить ли картинки и файлы. false — только текст.
bridge.files=true

# Предел на один файл, МБ. У самого Telegram потолок 50.
bridge.maxmegabytes=25

# Ссылка вебхука Discord. С ней сообщения из Telegram выходят под ником и
# аватаркой написавшего, а не одной строкой от имени бота. Берётся в настройках
# канала: Интеграции → Вебхуки → Создать → Копировать ссылку. Держи её как
# пароль: у кого ссылка, тот пишет в канал под любым именем. Можно задать
# переменной VOICEBRIDGE_DISCORD_WEBHOOK. Пусто — пишет бот, как раньше.
bridge.discord.webhook=

# Подставлять ли аватарки из Telegram. Работает только вместе с вебхуком.
bridge.avatars=true

# Свой адрес Bot API вместо официального — там, где api.telegram.org закрыт.
# Годится и то и другое:
#
#   свой пересыльщик в интернете (Cloudflare Worker, см. папку cloudflare):
#     bridge.telegram.api=https://имя.логин.workers.dev
#
#   свой сервер telegram-bot-api на этой же машине:
#     bridge.telegram.api=http://127.0.0.1:8081
#
# Разница только в аватарках: за картинкой Discord ходит сам, поэтому с адреса
# в интернете они работают, а с localhost — нет, туда Discord не дотянется.
# Прокси при локальном адресе не применяется: до своей машины он лишний.
# Пусто — официальный api.telegram.org.
bridge.telegram.api=

# HTTP-прокси, если до api.telegram.org не достучаться напрямую. Формат:
# «хост:порт» или «логин:пароль@хост:порт». Заворачивается только Telegram,
# остальное бот берёт обычным путём. Пусто — идти как есть.
#
# Прокси должен быть HTTP или HTTPS: SOCKS и MTProto-прокси из телеграм-каналов
# здесь не годятся — первый Java для этого не умеет, второй понимает только сам
# мессенджер, но не API для ботов.
#
# Токен прокси не увидит: соединение с Telegram шифруется внутри тоннеля, и
# снаружи виден лишь адрес api.telegram.org.
bridge.telegram.proxy=

# ---------------------------------------------------------------------------
# Пародийный бот в Telegram
# ---------------------------------------------------------------------------
# Отдельный телеграм-бот, который читает группу и время от времени вставляет
# реплику в манере выбранного участника. Реплики пишет ИИ: GigaChat от Сбера
# или Anthropic.
# Каждая начинается с «пародия:» — это не отключается. В Discord они не уходят:
# мост не переносит сообщения ботов.
#
# Пародируй только того, кто сам на это согласился.
parody.enabled=false

# Токен ВТОРОГО бота от @BotFather — не тот, что в bridge.telegram.token.
# Имя и аватарку ставят там же: /setname и /setuserpic.
# Обязательно: /setprivacy → бот → Disable, иначе он не видит переписку
# (после этого бота надо удалить из группы и добавить снова).
# Можно задать переменной VOICEBRIDGE_PARODY_TOKEN.
parody.telegram.token=

# Группа: @имя публичной или числовой ID закрытой.
parody.telegram.chat=@defenseBrawl

# Числовой ID участника в Telegram. Узнать: переслать его сообщение
# боту вроде @userinfobot.
parody.telegram.user=

# Как называть участника в подсказке для ИИ.
parody.name=

# С чего начинается каждая реплика. Слова можно поменять, но по пометке должно
# быть видно, что пишет не человек: нужно «пародия», «ИИ», «AI», «бот» или 🤖,
# не длиннее 40 знаков. Иначе берётся «пародия:». Пусто — «пародия:».
parody.mark=пародия:

# Твой числовой ID в Telegram — хозяина бота. Управлять пародией командами
# могут двое: ты и сам участник. Пусто — только участник.
#   /parody_say    — сказать что-нибудь сейчас
#   /parody_try    — пробная реплика только тебе, в личке с ботом
#   /parody_off    — выключить (бот молчит и не собирает сообщения)
#   /parody_on     — включить
#   /parody_forget — стереть собранные сообщения участника
#   /parody_status — сколько собрано, сколько сказано сегодня
#   /parody_name Санёк — ответом на сообщение: так называть этого человека
#   /parody_names  — кого как называть
# Команды работают и в группе, и в личке с ботом. Выключение переживает
# перезапуск: оно хранится в parody-state.json.
parody.telegram.owner=

# Чья модель сочиняет реплики: gigachat или anthropic.
#
# gigachat — работает из России без прокси, у физлиц есть бесплатный лимит.
# anthropic — пишет живее, но платный и из России отвечает только через прокси.
parody.llm.provider=gigachat

# Ключ. Можно задать переменной VOICEBRIDGE_LLM_KEY.
#
# GigaChat: https://developers.sber.ru/studio → войти через Сбер ID → создать
# проект GigaChat API → «Получить ключ». Нужен «Ключ авторизации»
# (Authorization key) — длинная строка, показывается один раз.
#
# Anthropic: https://console.anthropic.com → API Keys.
parody.llm.key=

# Имя модели. Для GigaChat можно оставить пустым — возьмётся GigaChat
# (бесплатный лимит — на неё; ещё бывают GigaChat-Pro и GigaChat-Max).
# Для Anthropic — список на https://docs.anthropic.com/en/docs/about-claude/models
parody.llm.model=

# Только для GigaChat: тариф ключа. GIGACHAT_API_PERS — физлица (по умолчанию),
# GIGACHAT_API_B2B и GIGACHAT_API_CORP — компании.
parody.llm.scope=GIGACHAT_API_PERS

# Только для GigaChat: корневой сертификат НУЦ Минцифры. Им подписаны серверы
# Сбера, а Java сама ему не доверяет. Скачай «Корневой сертификат» на
# https://www.gosuslugi.ru/crt и положи рядом с этим файлом под этим именем.
# Доверие к нему действует только на запросы к GigaChat, а не на весь бот.
parody.llm.cert=russian_trusted_root_ca.cer

# Свой адрес API вместо официального. Пусто — официальный.
parody.llm.url=

# HTTP-прокси до API: «хост:порт» или «логин:пароль@хост:порт».
# GigaChat из России работает напрямую. Anthropic из России отвечает
# ошибкой 403 — для него нужен прокси в другой стране.
parody.llm.proxy=

# С какой вероятностью, в процентах, бот встревает после чужого сообщения.
# На ответ на его собственную реплику и на упоминание по @имени бота
# он отвечает всегда (не чаще раза в 20 с).
parody.chance=5

# Сколько минут молчать после своей реплики, прежде чем встрять снова.
parody.cooldown=10

# Тихие часы по часам компьютера: «23-8» — с 23:00 до 8:00 бот молчит.
# Пусто — без тихих часов.
parody.quiet=

# Сколько реплик в сутки самое большее. 0 — без предела.
parody.daily=30

# Сколько сообщений участника набрать, прежде чем начать пародировать.
# Бот копит их сам, читая группу, и хранит в parody-samples.json.
parody.minsamples=20

# Чтобы не ждать: экспорт истории группы из Telegram Desktop
# (группа → ⋮ → Экспорт истории чата → формат JSON). Путь к result.json:
# просто result.json, если он лежит рядом с этим файлом, или полный путь —
# C:\Users\имя\Desktop\result.json. Забирается один раз.
parody.import=
