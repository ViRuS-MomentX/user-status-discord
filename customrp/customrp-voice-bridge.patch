@@ -0,0 +1,122 @@
+using System;
+using System.Windows.Forms;
+
+namespace CustomRPC
+{
+    /// <summary>
+    /// Settings window for the voice channel feature.
+    /// </summary>
+    /// <remarks>
+    /// Shows the bot's answer live while it's open, so that a wrong address or a bot that isn't
+    /// running is visible right here instead of as a presence that silently never changes.
+    /// </remarks>
+    public partial class VoiceBridgeForm : Form
+    {
+        readonly VoiceBridge bridge;
+        readonly Properties.Settings settings = Properties.Settings.Default;
+
+        public VoiceBridgeForm(VoiceBridge voiceBridge)
+        {
+            InitializeComponent();
+
+            bridge = voiceBridge;
+
+            WinApi.UseImmersiveDarkMode(Handle);
+
+            BackColor = CurrentColors.BgColor;
+            ForeColor = CurrentColors.TextColor;
+
+            foreach (Control control in Controls)
+            {
+                if (control is TextBox)
+                {
+                    control.BackColor = CurrentColors.BgTextFields;
+                    control.ForeColor = CurrentColors.TextColor;
+                }
+
+                if (control is Button button)
+                    button.FlatStyle = settings.darkMode ? FlatStyle.Flat : FlatStyle.Standard;
+            }
+
+            Text = Strings.voiceTitle;
+            checkBoxEnabled.Text = Strings.voiceEnable;
+            labelEndpoint.Text = Strings.voiceEndpoint;
+            labelSecret.Text = Strings.voiceSecret;
+            labelDetails.Text = Strings.voiceDetailsLabel;
+            labelState.Text = Strings.voiceStateLabel;
+            labelPlaceholders.Text = Strings.voicePlaceholders;
+            checkBoxTimestamp.Text = Strings.voiceUseTimestamp;
+            buttonCheck.Text = Strings.voiceCheck;
+            buttonClose.Text = Strings.voiceClose;
+
+            checkBoxEnabled.Checked = settings.voiceEnabled;
+            textBoxEndpoint.Text = settings.voiceUrl;
+            textBoxSecret.Text = settings.voiceToken;
+            textBoxDetails.Text = settings.voiceDetails;
+            textBoxState.Text = settings.voiceState;
+            checkBoxTimestamp.Checked = settings.voiceTimestamp;
+
+            RefreshStatus(this, EventArgs.Empty);
+            statusTimer.Start();
+        }
+
+        /// <summary>
+        /// Where to ask and what to show, as currently typed into the window.
+        /// </summary>
+        string Endpoint => textBoxEndpoint.Text.Trim();
+        string Secret => textBoxSecret.Text.Trim();
+
+        /// <summary>
+        /// Points the bridge at whatever is typed in right now, without waiting for the window to close.
+        /// </summary>
+        private void Check(object sender, EventArgs e)
+        {
+            labelStatus.Text = Strings.voiceStatusChecking;
+            bridge.Start(Endpoint, Secret);
+        }
+
+        /// <summary>
+        /// Repaints the status line from the bridge's latest answer.
+        /// </summary>
+        private void RefreshStatus(object sender, EventArgs e)
+        {
+            var status = bridge.Status;
+
+            if (!bridge.Reachable)
+            {
+                // An empty error means it was never asked in the first place
+                labelStatus.Text = bridge.LastError.Length == 0
+                    ? Strings.voiceStatusOff
+                    : string.Format(Strings.voiceStatusNoBot, bridge.LastError);
+                return;
+            }
+
+            if (status == null)
+            {
+                labelStatus.Text = Strings.voiceStatusChecking;
+                return;
+            }
+
+            if (!status.BotConnected)
+                labelStatus.Text = Strings.voiceStatusOffline;
+            else if (!status.InVoice)
+                labelStatus.Text = Strings.voiceStatusIdle;
+            else
+                labelStatus.Text = string.Format(Strings.voiceStatusInVoice, status.Guild, status.Channel, status.Members);
+        }
+
+        protected override void OnFormClosing(FormClosingEventArgs e)
+        {
+            statusTimer.Stop();
+
+            settings.voiceEnabled = checkBoxEnabled.Checked;
+            settings.voiceUrl = Endpoint;
+            settings.voiceToken = Secret;
+            settings.voiceDetails = textBoxDetails.Text;
+            settings.voiceState = textBoxState.Text;
+            settings.voiceTimestamp = checkBoxTimestamp.Checked;
+
+            base.OnFormClosing(e);
+        }
+    }
+}
